# ============================================================
# Dockerfile.vllm — Servidor vLLM con GPU NVIDIA
# ============================================================
# Imagen oficial de vLLM con CUDA incluido
# Compatible con GTX 3050 (Ampere, compute 8.6)
FROM vllm/vllm-openai:latest

# Variables de entorno para funcionamiento offline
# (el modelo debe estar descargado en el volumen montado)
ENV TRANSFORMERS_OFFLINE=1
ENV HF_DATASETS_OFFLINE=1
ENV PYTORCH_ALLOC_CONF=expandable_segments:True

# Directorio donde se montarán los modelos de HuggingFace
# En docker-compose montamos ~/.cache/huggingface aquí
ENV HF_HOME=/models

WORKDIR /workspace

# Exponer puerto de la API compatible con OpenAI
EXPOSE 8001

# El CMD se define en docker-compose para poder cambiar fácilmente
# el modelo o parámetros sin reconstruir la imagen
CMD ["python", "-m", "vllm.entrypoints.openai.api_server", \
     "--model", "Qwen/Qwen2.5-3B-Instruct-AWQ", \
     "--served-model-name", "llama3-local", \
     "--port", "8001", \
     "--host", "0.0.0.0", \
     "--quantization", "awq", \
     "--max-model-len", "4096", \
     "--gpu-memory-utilization", "0.90", \
     "--enforce-eager"]
